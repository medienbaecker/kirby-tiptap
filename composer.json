{
	"name": "medienbaecker/kirby-tiptap",
	"description": "Kirby Tiptap",
	"license": "MIT",
	"type": "kirby-plugin",
	"version": "6.0.0-rc.3",
	"authors": [
		{
			"name": "Thomas Günther",
			"email": "mail@medienbaecker.com"
		}
	],
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0",
		"getkirby/composer-installer": "^1.1",
		"ueberdosis/tiptap-php": "^2.1.1"
	},
	"autoload": {
		"psr-4": {
			"Medienbaecker\\Tiptap\\": "lib/"
		},
		"files": [
			"lib/helpers.php"
		]
	},
	"extra": {
		"kirby": {
			"compatible": "^6.0"
		}
	},
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	}
}
